{
  "manifest_version": 3,
  "name": "FC 27 Web App Toolkit",
  "version": "1.28.3",
  "description": "Quality-of-life improvements for the EA SPORTS FC 27 Ultimate Team Web App.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FC 27 Web App Toolkit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "declarativeContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": [
        "src/storage-bridge.js",
        "src/wide-mode.js",
        "src/store-packs.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": [
        "src/match-stats.js",
        "src/card-info.js",
        "src/price-check.js",
        "src/shortcuts.js",
        "src/club-list.js",
        "src/sniper.js",
        "src/transfer-list.js",
        "src/club-sort.js",
        "src/sbc-helper.js",
        "src/player-lock.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
